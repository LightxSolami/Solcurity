# Solana RPC URL (public or Helius/Alchemy)
SOLANARPCURL=https://api.mainnet-beta.solana.com

# Your deployed app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# Groq API key for AI explanations (optional)
GROQ_API_KEY=

# Supabase (for threat intel & alerts) - SERVER ONLY
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Threat intel moderator token (optional)
THREAT_INTEL_MODERATOR_TOKEN=

# Telegram bot - SERVER ONLY
BOT_TOKEN=
BOT_USERNAME=SolcurityBot
WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ADMIN_TOKEN=
TELEGRAM_CRON_SECRET=

# Scheduled AI News Debate (server-side only)
# Get free keys from: Groq (groq.com), Gemini (ai.google.dev), HuggingFace (huggingface.co), Together.ai (together.ai)
# Configure at least one provider key. GROQ_API_KEY above can be shared with the debate service.
CRON_SECRET=
AI_NEWS_CRON_SECRET=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=

# AI News config
AI_NEWS_MAX_ITEMS=8
AI_NEWS_QUICK_MODE=false