# Server-side Supabase project URL and service-role key.
# Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Configure a strong random token before enabling moderator routes.
THREAT_INTEL_MODERATOR_TOKEN=replace-with-a-long-random-secret
