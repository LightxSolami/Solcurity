# --- server (copy to server/.env or export before `npm start`) ---
PORT=8080
PAID_ENABLED=false                 # keep false until audit + legal review are done
# Needed only when PAID_ENABLED=true:
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=                        # printed by `anchor keys list` after `anchor keys sync`
SERVER_KEYPAIR=/secure/path/server-keypair.json   # NEVER commit. Needs SOL only for rent + fees.
TREASURY_PUBKEY=                   # wallet that receives the platform fee
FEE_BPS=500                        # 5 %, program hard cap is 10 %
