# --- server (export these variables before starting the server) ---
PORT=8080
PAID_ENABLED=false                 # keep false until audit + legal review are done
# Non-Mainnet beta testing only; Testnet and Devnet SOL have no real value.
# Use a dedicated test-only server keypair. Never use a Mainnet wallet.
CLUSTER=testnet
RPC_URL=https://api.testnet.solana.com
PROGRAM_ID=                        # printed by `anchor keys list` after `anchor keys sync`
SERVER_KEYPAIR=/secure/path/server-keypair.json   # NEVER commit. Needs SOL only for rent + fees.
TREASURY_PUBKEY=DLbjcTvMHuvENT1336tdSRd9giHzJd5Uwo5WraqQ3k82
FEE_BPS=50                         # fixed 0.5% program fee
