# --- server (export these variables before starting the server) ---
PORT=8080
PAID_ENABLED=false                 # keep false until audit + legal review are done
# Wagering is locked to Devnet in the server. Mainnet is not supported.
# Needed only for Devnet testing when PAID_ENABLED=true:
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=                        # printed by `anchor keys list` after `anchor keys sync`
SERVER_KEYPAIR=/secure/path/server-keypair.json   # NEVER commit. Needs SOL only for rent + fees.
